# AfterCircular web — copy to .env.local. Every value here is SERVER-ONLY: nothing is prefixed NEXT_PUBLIC_, so no
# secret reaches the browser. The dashboard calls its own /api/backend proxy, which adds the backend key and the
# signed-in user's GitHub token server-side.

# ---- Auth.js ---------------------------------------------------------------
# openssl rand -base64 32   (or: npx auth secret)
AUTH_SECRET=
# GitHub OAuth App → Settings → Developer settings → OAuth Apps
# Callback URL: http://localhost:3000/api/auth/callback/github  (prod: https://<host>/api/auth/callback/github)
AUTH_GITHUB_ID=
AUTH_GITHUB_SECRET=
# Set to true behind a reverse proxy / Azure App Service / Container Apps.
AUTH_TRUST_HOST=true
# Canonical public URL. Required in production (Container Apps): the OAuth callback is built from it.
# AUTH_URL=https://aca-aftercircular-web.<region>.azurecontainerapps.io

# ---- Backend (FastAPI) -----------------------------------------------------
# When both are set, tenants are stored by the backend. Otherwise a dev JSON file (data/tenants.json) is used.
# local: http://localhost:8010 · docker compose: http://api:8000 · Azure: http://aca-aftercircular-api (internal ingress)
BACKEND_URL=http://localhost:8010
BACKEND_API_KEY=
# Single-instance demo only: allow the JSON tenant store in production builds.
# ALLOW_JSON_TENANT_STORE=true
