# ---- Auth.js ---------------------------------------------------------------
# openssl rand -base64 32   (or: npx auth secret)
AUTH_SECRET=
# GitHub OAuth App → Settings → Developer settings → OAuth Apps
# Callback URL: http://localhost:3000/api/auth/callback/github  (prod: https://<host>/api/auth/callback/github)
AUTH_GITHUB_ID=
AUTH_GITHUB_SECRET=
# Set to true behind a reverse proxy / Azure App Service / Container Apps.
AUTH_TRUST_HOST=true
# Optional: canonical public URL (needed only if the proxy hides the original host).
# AUTH_URL=https://aftercircular.example.com

# ---- Backend (FastAPI) -----------------------------------------------------
# When both are set, tenants are stored by the backend. Otherwise a dev JSON file (data/tenants.json) is used.
BACKEND_URL=http://localhost:8010
BACKEND_API_KEY=
# Single-instance demo only: allow the JSON tenant store in production builds.
# ALLOW_JSON_TENANT_STORE=true
