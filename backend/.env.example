# ---- Backend --------------------------------------------------------------
# Shared secret between the Next.js frontend and this API (same value as web/.env.local BACKEND_API_KEY).
BACKEND_API_KEY=change-me
DATABASE_PATH=data/aftercircular.db
# Comma-separated origins allowed to call the API directly (the Next.js proxy is the normal path).
CORS_ORIGINS=http://localhost:3000

# ---- AI provider (Microsoft Foundry / Azure OpenAI) ------------------------
# foundry = real model calls. stub = fixture outputs from evals/scenarios, clearly labelled, no AI.
AI_PROVIDER=foundry
# Foundry project / Azure OpenAI resource endpoint, e.g. https://<resource>.openai.azure.com or https://<resource>.services.ai.azure.com
FOUNDRY_ENDPOINT=
# Leave empty to use Entra ID (DefaultAzureCredential / managed identity) instead of a key. Local dev only.
FOUNDRY_API_KEY=
# Inference uses the GA v1 API at <FOUNDRY_ENDPOINT>/openai/v1/ — no api-version. responses = Responses API (default), chat = chat.completions.
FOUNDRY_API=responses
# Foundry project endpoint (…/api/projects/<name>) — recorded for tracing/evals only.
FOUNDRY_PROJECT_ENDPOINT=
# Deployment names in your Foundry project — one per task (PRD §23).
EXTRACTION_MODEL=gpt-4o-mini
IMPACT_MODEL=gpt-4o
MEMO_MODEL=gpt-4o-mini
EMBEDDING_MODEL=text-embedding-3-small
# Comma-separated deployments to compare in `python -m evals.run` (defaults to the three above).
EVAL_MODELS=

# USD per 1M tokens per deployment, [input, cached_input, output] — only for *estimated* cost telemetry.
# MODEL_PRICING_JSON={"gpt-4.1-mini":[0.4,0.1,1.6]}

# ---- Cost guardrails (development defaults; raise only after the single-document pipeline is verified) ----
AFTERCIRCULAR_MAX_DOCUMENTS_PER_SCAN=1
AFTERCIRCULAR_MAX_LLM_CALLS_PER_SCAN=10
AFTERCIRCULAR_MAX_RETRIES=2
AFTERCIRCULAR_MAX_CONCURRENT_CALLS=2
AFTERCIRCULAR_ENABLE_LIVE_SCAN=true
AFTERCIRCULAR_ENABLE_SCHEDULED_SCAN=false
# Application circuit breakers on *estimated* spend (list-price table; NOT Azure billing limits). 0 disables a limit.
# A scan that reaches the scan limit stops generative work (BUDGET_EXCEEDED audit event); a day at the daily limit refuses new scans.
AFTERCIRCULAR_MAX_ESTIMATED_COST_PER_SCAN_USD=0.50
AFTERCIRCULAR_MAX_ESTIMATED_COST_PER_DAY_USD=5.00

# ---- Context budgets + TOON --------------------------------------------------
# Repeated structured context (obligations, policy excerpts, evidence) is sent to Foundry as TOON; JSON stays at API boundaries.
TOON_CONTEXT=true
MAX_OBLIGATIONS_IN_CONTEXT=12
MAX_POLICY_CHUNKS=8
MAX_EVIDENCE_ITEMS=8
MAX_EVIDENCE_TOKENS=3000
MAX_CONTEXT_TOKENS=12000

# ---- Azure AI Search (hybrid BM25 + vector, RRF). Empty endpoint = local in-process hybrid index. ----
# e.g. https://srch-aftercircular-dev.search.windows.net
AZURE_SEARCH_ENDPOINT=
# ONE index per environment; tenants are isolated by the filterable tenant_id field. Schema: docs/azure/policies-dev.index.json
AZURE_SEARCH_INDEX=policies-dev
# Empty key → DefaultAzureCredential / Entra ID (az login locally, managed identity in Azure): Search Index Data Contributor
# on the service is enough when the index already exists; Search Service Contributor only if the app must create it.
AZURE_SEARCH_API_KEY=
# Must equal the deployed embedding model's output size and the index vector field (text-embedding-3-small = 1536).
EMBEDDING_DIMENSIONS=1536
# Name a semantic configuration to add L2 semantic reranking (billed per query) — off by default.
AZURE_SEARCH_SEMANTIC_CONFIG=

# ---- Observability / environment ------------------------------------------------
# Application Insights connection string → traces, dependencies, logs (tokens, cost, TOON/JSON per call). Empty = logs only.
APPLICATIONINSIGHTS_CONNECTION_STRING=
# dev | demo | production — shown in /health; never point a dev backend at the demo database.
ENVIRONMENT=dev

# ---- Regulatory source -----------------------------------------------------
# live = fetch sebi.gov.in and fall back to the demo snapshot if unreachable. snapshot = always use the snapshot.
SEBI_MODE=live
SEBI_MAX_DOCUMENTS=5
SEBI_TIMEOUT_SECONDS=20

# ---- GitHub ----------------------------------------------------------------
# Fallback token for reading the policy repository and creating issues when the request carries no user token.
GITHUB_TOKEN=

# ---- TypeSafe System One (Jev) — typed judgments -----------------------------
# Create a key at https://console.typesafe.ai/. Used for applicability, policy relevance (rerank), alignment,
# obligation checks and citation verification. Empty → those tasks fall back to the stub judge (labelled).
TYPESAFE_API_KEY=
TYPESAFE_MODEL=jev-latest
# Route individual tasks to a judge: typesafe | foundry (uncalibrated emulation) | stub.
# Tasks: extraction_check, applicability, rerank, alignment, verification. Unlisted tasks use DEFAULT_JUDGE.
DECISION_ROUTES=
DEFAULT_JUDGE=typesafe
# Override routing thresholds (see app/decisions/policy.py), e.g. {"alignment_min_confidence": 0.75}
# DECISION_THRESHOLDS=
