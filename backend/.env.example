# ---- Backend --------------------------------------------------------------
# Shared secret between the Next.js frontend and this API (same value as web/.env.local BACKEND_API_KEY).
BACKEND_API_KEY=change-me
DATABASE_PATH=data/aftercircular.db
# Comma-separated origins allowed to call the API directly (the Next.js proxy is the normal path).
CORS_ORIGINS=http://localhost:3000

# ---- AI provider (Microsoft Foundry / Azure OpenAI) ------------------------
# foundry = real model calls. stub = fixture outputs from evals/scenarios, clearly labelled, no AI.
AI_PROVIDER=foundry
# Foundry project / Azure OpenAI resource endpoint, e.g. https://<resource>.openai.azure.com or https://<resource>.services.ai.azure.com
FOUNDRY_ENDPOINT=
# Leave empty to use Entra ID (DefaultAzureCredential / managed identity) instead of a key.
FOUNDRY_API_KEY=
FOUNDRY_API_VERSION=2024-10-21
# Deployment names in your Foundry project — one per task (PRD §23).
EXTRACTION_MODEL=gpt-4o-mini
IMPACT_MODEL=gpt-4o
MEMO_MODEL=gpt-4o-mini
EMBEDDING_MODEL=text-embedding-3-small
# Comma-separated deployments to compare in `python -m evals.run` (defaults to the three above).
EVAL_MODELS=

# ---- Azure AI Search (hybrid vector + keyword). Empty = local in-process hybrid index. ----
AZURE_SEARCH_ENDPOINT=
AZURE_SEARCH_API_KEY=

# ---- Regulatory source -----------------------------------------------------
# live = fetch sebi.gov.in and fall back to the demo snapshot if unreachable. snapshot = always use the snapshot.
SEBI_MODE=live
SEBI_MAX_DOCUMENTS=5
SEBI_TIMEOUT_SECONDS=20

# ---- GitHub ----------------------------------------------------------------
# Fallback token for reading the policy repository and creating issues when the request carries no user token.
GITHUB_TOKEN=

# ---- TypeSafe System One (Jev) — typed judgments -----------------------------
# Create a key at https://console.typesafe.ai/. Used for applicability, policy relevance (rerank), alignment,
# obligation checks and citation verification. Empty → those tasks fall back to the stub judge (labelled).
TYPESAFE_API_KEY=
TYPESAFE_MODEL=jev-latest
# Route individual tasks to a judge: typesafe | foundry (uncalibrated emulation) | stub.
# Tasks: extraction_check, applicability, rerank, alignment, verification. Unlisted tasks use DEFAULT_JUDGE.
DECISION_ROUTES=
DEFAULT_JUDGE=typesafe
# Override routing thresholds (see app/decisions/policy.py), e.g. {"alignment_min_confidence": 0.75}
# DECISION_THRESHOLDS=
